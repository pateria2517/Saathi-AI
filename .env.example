# ==============================================================================
# SAATHI AI — ENVIRONMENT CONFIGURATION
# Default mode is 100% OFFLINE with no API keys required.
# ==============================================================================

# Server Network Settings
HOST=127.0.0.1
PORT=8000

# Canonical Knowledge Base (Single Source of Truth)
KNOWLEDGE_PATH=Saathi_AI_combined_710_faq_1.json
DATABASE_PATH=saathi_demo.sqlite3

# ------------------------------------------------------------------------------
# LLM Providers (Default: "none" for offline local FAQ retrieval demo)
# Options: none | openai | anthropic | gemini
# ------------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Anthropic Claude (Optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (Optional)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Embeddings (Default: "none" - uses built-in lexical + BM25 retrieval)
# Options: none | openai
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Text-To-Speech (TTS)
# Options: browser (default, zero keys) | edge-tts (free neural) | openai (paid)
# ------------------------------------------------------------------------------
TTS_PROVIDER=browser
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=tts-1
TTS_VOICE=coral

# ------------------------------------------------------------------------------
# Model Context Protocol (MCP) Server
# ------------------------------------------------------------------------------
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
MCP_PROTOCOL_VERSION=2024-11-05

# ------------------------------------------------------------------------------
# Admin & Retrieval Calibration
# ------------------------------------------------------------------------------
ADMIN_TOKEN=saathi_dev_admin_secret_token
MIN_RETRIEVAL_SCORE=0.35

# ------------------------------------------------------------------------------
# Telephony Integration (Default: simulator for browser-based mic call)
# Options: simulator | twilio | exotel
# ------------------------------------------------------------------------------
TELEPHONY_PROVIDER=simulator
TELEPHONY_ACCOUNT_SID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_PHONE_NUMBER=
